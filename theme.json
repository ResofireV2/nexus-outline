{
  "manifest_version": 1,
  "name": "Outline",
  "slug": "nexus-outline",
  "version": "1.1.0",
  "author": "ResofireV2",
  "description": "Clean light theme. Everything defined by borders \u2014 no background fills anywhere. Accent color does all the work.",
  "homepage": "https://github.com/ResofireV2/nexus-theme-outline",
  "categories": [
    "light",
    "minimal",
    "clean"
  ],
  "modes": {
    "light": {
      "variables": {
        "--bg": "#f8f8f9",
        "--s1": "#ffffff",
        "--s2": "#f0f0f2",
        "--s3": "#e8e8eb",
        "--t1": "#1a1428",
        "--t2": "rgba(26,20,80,0.70)",
        "--t3": "rgba(26,20,80,0.50)",
        "--t4": "rgba(26,20,80,0.30)",
        "--t5": "rgba(26,20,80,0.18)",
        "--b1": "rgba(26,20,80,0.07)",
        "--b2": "rgba(26,20,80,0.10)",
        "--b3": "rgba(26,20,80,0.14)"
      }
    }
  }
}